{
  "entities": {
    "product": {
      "title": "Product",
      "description": "Premium Private Reserve Product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "pricePerGram": { "type": "number" },
        "currency": { "type": "string" },
        "category": { "type": "string" },
        "displayZone": { "type": "string" },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "author": { "type": "string" },
        "views": { "type": "number" },
        "duration": { "type": "string" },
        "isUploaded": { "type": "boolean" },
        "additionalPhotos": { "type": "array" }
      },
      "required": ["id", "title", "price", "videoUrl"]
    },
    "order": {
      "title": "Order",
      "description": "Customer order journal record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "bankName": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "customerName", "phoneNumber", "totalAmount", "status"]
    },
    "settings": {
      "title": "BrandingSettings",
      "description": "Branding settings and metadata",
      "type": "object",
      "properties": {
        "introBgUrl": { "type": "string" },
        "launchScreenUrl": { "type": "string" },
        "homepageHeroBgUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "introStatusLine": { "type": "string" },
        "sectionTitles": { "type": "array" }
      }
    },
    "whitelist": {
      "title": "WhitelistItem",
      "description": "Telegram ID / Username white list pattern",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "string" },
        "type": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "value", "type"]
    },
    "connectionLog": {
      "title": "ConnectionLog",
      "description": "Log of user access checks and device connections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "telegramId": { "type": "string" },
        "username": { "type": "string" },
        "date": { "type": "string" },
        "device": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "telegramId", "date", "status"]
    },
    "userProfile": {
      "title": "UserProfile",
      "description": "Luxurious VIP space user profile record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "telegramId": { "type": "string" },
        "telegramUsername": { "type": "string" },
        "pseudo": { "type": "string" },
        "dateJoined": { "type": "string" },
        "points": { "type": "number" },
        "level": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "unlockedRewards": { "type": "array" }
      },
      "required": ["id", "telegramId", "pseudo"]
    },
    "systemFile": {
      "title": "SystemFile",
      "description": "Metadata for split binary backup files",
      "type": "object",
      "properties": {
        "filename": { "type": "string" },
        "mimeType": { "type": "string" },
        "size": { "type": "number" },
        "totalChunks": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["filename", "mimeType", "size", "totalChunks", "createdAt"]
    },
    "systemFileChunk": {
      "title": "SystemFileChunk",
      "description": "Base64 coded data chunk of a backup file",
      "type": "object",
      "properties": {
        "chunkIndex": { "type": "number" },
        "data": { "type": "string" }
      },
      "required": ["chunkIndex", "data"]
    },
    "promoSent": {
      "title": "PromoSent",
      "description": "Tracks users who have been sent the Instagram promotional message",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "date": { "type": "string" },
        "success": { "type": "boolean" }
      },
      "required": ["chatId"]
    },
    "reward": {
      "title": "Reward",
      "description": "Dynamic manageable loyalty reward",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "minOrders": { "type": "number" },
        "isActive": { "type": "boolean" },
        "promoCode": { "type": "string" }
      },
      "required": ["id", "title", "minOrders", "isActive"]
    },
    "promoCode": {
      "title": "PromoCode",
      "description": "Manageable promotional discount code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string" },
        "value": { "type": "number" },
        "maxUses": { "type": "number" },
        "timesUsed": { "type": "number" },
        "expiredAt": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "code", "type", "value", "isActive"]
    },
    "lastBroadcast": {
      "title": "LastBroadcast",
      "description": "Tracks the last broadcasted Telegram messages for revocation/undo purposes",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "messageId": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["chatId", "messageId", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "product",
      "description": "Store items and media links"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Store customers orders"
    },
    "/settings/branding": {
      "schema": "settings",
      "description": "Visual settings configurations"
    },
    "/whitelist/{whitelistId}": {
      "schema": "whitelist",
      "description": "Telegram access whitelist identifiers"
    },
    "/connection_logs/{logId}": {
      "schema": "connectionLog",
      "description": "Logs of Telegram connection attempts and device identifiers"
    },
    "/system_files/{filename}": {
      "schema": "systemFile",
      "description": "Metadata references for binary file chunks"
    },
    "/system_files/{filename}/chunks/{chunkId}": {
      "schema": "systemFileChunk",
      "description": "Data chunks of split files representing raw binary data"
    },
    "/promo_sent/{chatId}": {
      "schema": "promoSent",
      "description": "Telegram user promo sent tracking"
    },
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "VIP members and NORTH47 loyalty registers"
    },
    "/rewards/{rewardId}": {
      "schema": "reward",
      "description": "Loyalty tier rewards customizable"
    },
    "/promo_codes/{promoId}": {
      "schema": "promoCode",
      "description": "Customizable promotional discount registers"
    },
    "/last_broadcast/{chatId}": {
      "schema": "lastBroadcast",
      "description": "Telegram individual user broadcast message tracking for undo/deletion"
    }
  }
}
